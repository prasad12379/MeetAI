<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Outer glow ring -->
    <FrameLayout
        android:id="@+id/logoGlow"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerInParent="true"
        android:layout_marginBottom="40dp"
        android:background="@drawable/neon_circle_glow"
        android:alpha="0">

        <!-- Inner dark circle -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            app:cardCornerRadius="60dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1A1A2E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="#2ACFD9"
                    android:fontFamily="sans-serif-condensed"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- App name -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/logoGlow"
        android:layout_marginTop="24dp"
        android:text="NexMeet"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.08"
        android:alpha="0"/>

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tvAppName"
        android:layout_marginTop="8dp"
        android:text="Connect beyond boundaries"
        android:textSize="13sp"
        android:textColor="#602ACFD9"
        android:letterSpacing="0.06"
        android:alpha="0"/>

    <!-- Loading dots -->
    <LinearLayout
        android:id="@+id/loadingDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:alpha="0">

        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/dot_neon" android:layout_marginEnd="6dp"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/dot_neon" android:layout_marginEnd="6dp"
            android:alpha="0.5"/>
        <View android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/dot_neon"
            android:alpha="0.25"/>
    </LinearLayout>

</RelativeLayout>