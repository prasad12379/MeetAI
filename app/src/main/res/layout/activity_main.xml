<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml  —  MeetAI
    ─────────────────────────────────────────────────────────────────────────
    Layout structure:
      • fragmentContainer  — full-screen, fragments draw here edge-to-edge
      • navOverlay         — sits on top, holds the Compose floating pill nav
                             (match_parent so the Compose Box can anchor to bottom)

    The old BottomNavigationView and glowWrapper are removed entirely.
    Navigation chrome is now 100% Compose inside MainActivity.kt.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- Fragment host — full screen, no bottom padding -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay for the floating Compose pill nav -->
    <FrameLayout
        android:id="@+id/navOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

</FrameLayout>