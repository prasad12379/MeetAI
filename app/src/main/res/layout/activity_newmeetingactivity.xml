<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="9dp"
            app:tint="#FFFFFF"
            android:background="@drawable/neon_icon_bg"
            android:elevation="4dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New Meeting"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:fontFamily="sans-serif-condensed"/>

        <View android:layout_width="42dp" android:layout_height="42dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Room code card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/neon_card_cyan"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Meeting Code"
                        android:textSize="13sp"
                        android:textColor="#60FFFFFF"
                        android:layout_marginBottom="12dp"
                        android:letterSpacing="0.06"/>

                    <TextView
                        android:id="@+id/tvRoomCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NXM-4829-KL"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:textColor="#2ACFD9"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp"/>

                    <!-- Copy / Refresh row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnCopyCode"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="10dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#1A2ACFD9"
                            android:foreground="?android:attr/selectableItemBackground">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center" android:orientation="horizontal">
                                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                    android:src="@drawable/ic_copy" app:tint="#2ACFD9"
                                    android:layout_marginEnd="6dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="Copy" android:textSize="13sp"
                                    android:textStyle="bold" android:textColor="#2ACFD9"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnRefreshCode"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#18FFFFFF"
                            android:foreground="?android:attr/selectableItemBackground">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center" android:orientation="horizontal">
                                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                    android:src="@drawable/ic_refresh" app:tint="#CCFFFFFF"
                                    android:layout_marginEnd="6dp"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="New Code" android:textSize="13sp"
                                    android:textStyle="bold" android:textColor="#CCFFFFFF"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Pre-meeting settings card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/neon_card_cyan"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Before you start"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="18dp"/>

                    <!-- Mic toggle row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/neon_dot_cyan"
                            android:layout_marginEnd="14dp">
                            <ImageView android:id="@+id/ivMicIcon"
                                android:layout_width="22dp" android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mic" app:tint="#2ACFD9"/>
                        </FrameLayout>

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Microphone" android:textSize="14sp"
                            android:textColor="#FFFFFF"/>

                        <Switch
                            android:id="@+id/switchMic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#2ACFD9"
                            android:trackTint="#302ACFD9"/>
                    </LinearLayout>

                    <!-- Camera toggle row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/neon_dot_amber"
                            android:layout_marginEnd="14dp">
                            <ImageView android:id="@+id/ivCamIcon"
                                android:layout_width="22dp" android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_videocam" app:tint="#FFC107"/>
                        </FrameLayout>

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Camera" android:textSize="14sp"
                            android:textColor="#FFFFFF"/>

                        <Switch
                            android:id="@+id/switchCamera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:thumbTint="#FFC107"
                            android:trackTint="#30FFC107"/>
                    </LinearLayout>

                    <!-- ── NEW: Transcript toggle row ──────────────────── -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#20FFFFFF"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/neon_dot_cyan"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mic"
                                app:tint="#A855F7"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Meeting Transcript"
                                android:textSize="14sp"
                                android:textColor="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saves speech as .txt file"
                                android:textSize="11sp"
                                android:textColor="#80FFFFFF"/>
                        </LinearLayout>

                        <Switch
                            android:id="@+id/switchTranscript"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            android:thumbTint="#A855F7"
                            android:trackTint="#30A855F7"/>
                    </LinearLayout>
                    <!-- ── END Transcript toggle ───────────────────────── -->

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Start Meeting button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@drawable/neon_button_glow"
                android:elevation="12dp"
                android:padding="6dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/btnStartMeeting"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#1A1A1A"
                    android:foreground="?android:attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp">

                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_video_call" app:tint="#2ACFD9"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="START MEETING"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:letterSpacing="0.08"
                            android:fontFamily="sans-serif-condensed"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>