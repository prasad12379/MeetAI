<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/neon_input_field_cyan.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer soft glow -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <stroke android:width="3dp" android:color="#202ACFD9"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
    <!-- inner field with cyan tint fill + bright border -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#0F2ACFD9"/>
            <stroke android:width="1dp" android:color="#602ACFD9"/>
        </shape>
    </item>
</layer-list>